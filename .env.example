# IsleForge environment variables — copy to .env and fill in.
# NEVER commit a real .env with secrets.

# ── Database ──────────────────────────────────────────────────────
# Production: point at a managed PostgreSQL.
# Development: if unset, the server runs WITHOUT auth (guest-only, M4 mode).
#   To run auth locally without installing Postgres, the db package can
#   start an embedded PostgreSQL (see AUTH_ARCHITECTURE.md).
DATABASE_URL=postgresql://isleforge:CHANGE_ME@127.0.0.1:5432/isleforge

# ── Auth ──────────────────────────────────────────────────────────
# HMAC secret for signing access-token JWTs. REQUIRED when auth is enabled.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be at least 32 characters. Rotate with care (invalidates sessions).
AUTH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# Set to "true" behind HTTPS so cookies get the Secure flag.
# Leave "false" for http://localhost development.
COOKIE_SECURE=false

# Expose password-reset / verification tokens in API responses.
# Development only (no email provider). NEVER true in production.
DEV_EXPOSE_RESET_TOKENS=true

# ── Server ────────────────────────────────────────────────────────
PORT=8080
