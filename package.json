{
  "description": "Isleforge \u2014 an original online strategy board-game platform. Monorepo.",
  "engines": {
    "node": ">=20"
  },
  "name": "isleforge",
  "private": true,
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:server": "npm run dev --workspace @isleforge/server",
    "dev:web": "npm run dev --workspace @isleforge/web"
  },
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
