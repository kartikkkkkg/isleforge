{
  "dependencies": {
    "embedded-postgres": "^18.4.0-beta.17",
    "pg": "^8.13.1"
  },
  "description": "PostgreSQL persistence for Isleforge (Milestone 5): versioned migrations, typed repositories for users, profiles, sessions, password resets. No game rules here.",
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.11.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "main": "./dist/index.js",
  "name": "@isleforge/db",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "migrate": "node dist/migrate-cli.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.check.json"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "0.5.0"
}